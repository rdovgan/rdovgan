diff --git a/src/private-repos.ts b/src/private-repos.ts
new file mode 100644
index 0000000..b0ed02b
--- /dev/null
+++ b/src/private-repos.ts
@@ -0,0 +1,149 @@
+import axios from 'axios';
+import { URL, CommitContributionsByRepository } from './github-graphql';
+
+const pageSize = 25;
+
+type AccountResponse = {
+    data?: {
+        user: {
+            id: string;
+            contributionsCollection: {
+                restrictedContributionsCount: number;
+            };
+        };
+    };
+    errors?: Array<{ message: string }>;
+};
+
+type RepositoriesResponse = {
+    data?: {
+        user: {
+            repositories: {
+                pageInfo: {
+                    hasNextPage: boolean;
+                    endCursor: string | null;
+                };
+                nodes: Array<{
+                    primaryLanguage: {
+                        name: string;
+                        color: string | null;
+                    } | null;
+                    defaultBranchRef: {
+                        target: {
+                            history?: {
+                                totalCount: number;
+                            };
+                        };
+                    } | null;
+                }>;
+            };
+        };
+    };
+    errors?: Array<{ message: string }>;
+};
+
+const post = async <T>(
+    token: string,
+    query: string,
+    variables: Record<string, unknown>,
+): Promise<T> => {
+    const response = await axios.post<T>(
+        URL,
+        { query: query.replace(/\s+/g, ' '), variables },
+        { headers: { Authorization: `bearer ${token}` } },
+    );
+    return response.data;
+};
+
+/**
+ * Commits of the user in their own private repositories.
+ * contributionsCollection hides them (restrictedContributionsCount) even from a token with the repo scope,
+ * so they are counted from the default branch history of each private repository instead.
+ */
+export const fetchPrivateRepoCommits = async (
+    token: string,
+    userName: string,
+    since: string,
+    until: string,
+): Promise<CommitContributionsByRepository> => {
+    const account = await post<AccountResponse>(
+        token,
+        `
+            query($login: String!, $from: DateTime!, $to: DateTime!) {
+                user(login: $login) {
+                    id
+                    contributionsCollection(from: $from, to: $to) {
+                        restrictedContributionsCount
+                    }
+                }
+            }
+        `,
+        { login: userName, from: since, to: until },
+    );
+    if (!account.data) {
+        console.warn('private repos: cannot read the account', account.errors);
+        return [];
+    }
+    const { id, contributionsCollection } = account.data.user;
+    if (contributionsCollection.restrictedContributionsCount === 0) {
+        // Private contributions are already visible (or there are none)
+        return [];
+    }
+
+    const result: CommitContributionsByRepository = [];
+    let cursor: string | null = null;
+    do {
+        const page: RepositoriesResponse = await post<RepositoriesResponse>(
+            token,
+            `
+                query($login: String!, $cursor: String, $author: ID!, $since: GitTimestamp!, $until: GitTimestamp!) {
+                    user(login: $login) {
+                        repositories(first: ${pageSize}, after: $cursor, ownerAffiliations: OWNER, privacy: PRIVATE, isFork: false) {
+                            pageInfo {
+                                hasNextPage
+                                endCursor
+                            }
+                            nodes {
+                                primaryLanguage {
+                                    name
+                                    color
+                                }
+                                defaultBranchRef {
+                                    target {
+                                        ... on Commit {
+                                            history(author: { id: $author }, since: $since, until: $until) {
+                                                totalCount
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            `,
+            { login: userName, cursor, author: id, since, until },
+        );
+        if (!page.data) {
+            console.warn('private repos: cannot read repositories', page.errors);
+            break;
+        }
+        const repositories = page.data.user.repositories;
+        for (const repo of repositories.nodes) {
+            const totalCount = repo.defaultBranchRef?.target.history?.totalCount ?? 0;
+            if (totalCount > 0) {
+                result.push({
+                    contributions: { totalCount },
+                    repository: { primaryLanguage: repo.primaryLanguage },
+                });
+            }
+        }
+        cursor = repositories.pageInfo.hasNextPage
+            ? repositories.pageInfo.endCursor
+            : null;
+    } while (cursor);
+
+    const commits = result.reduce((sum, repo) => sum + repo.contributions.totalCount, 0);
+    console.log(`private repos: added ${commits} commits from ${result.length} repositories`);
+    return result;
+};
